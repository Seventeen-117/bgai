# 应用配置
bgai:
  mock:
    discovery: true  # 设置为true启用模拟服务注册，解决多个DiscoveryClient冲突
  api-key:
    enabled: true
    header-name: X-API-Key
    test-key: test-api-key-123  # 添加测试API Key配置
# OCR Configuration
tesseract:
  data:
    path: /usr/share/tesseract-ocr

# MyBatis-Plus Configuration
mybatis-plus:
  mapper-locations: classpath*:/mapper/**/*.xml
  type-aliases-package: com.bgpay.bgai.entity
  configuration:
    map-underscore-to-camel-case: true
    cache-enabled: false
    log-impl: org.apache.ibatis.logging.slf4j.Slf4jImpl
  global-config:
    db-config:
      id-type: auto
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

#mq
rocketmq:
  name-server: 8.133.246.113:9876
  producer:
    group: billing-producer-group
    send-message-timeout: 3000
    retry-times-when-send-failed: 2
  consumer:
    group: billing-consumer-group
    consume-timeout: 120s
  topic:
    chat-log: chat_log_topic

# 新增配置
conversation:
  max-rounds: 5 # 最大保留5轮完整对话（10条消息）
flink:
  job-manager:
    host: 8.133.246.113
    port: 8081 
file:
  output:
    path: /var/data/ai_responses
# 日志文件路径
logging:
  file:
    path: /var/data/ai_responses
    name: ${logging.file.path}/application.log
  config: classpath:nacos-logback.xml
  level:
    com.alibaba.nacos: INFO
    com.alibaba.nacos.client: INFO 
    com.bgpay.bgai.mapper: debug 
    io.seata: info
    com.bgpay.bgai: debug
    com.bgpay.bgai.feign: DEBUG
    org.springframework.cloud.context.scope: warn
    org.springframework.context.support: warn
    org.springframework.beans.factory.support: warn
    org.springframework.cloud.commons.util: warn
    org.springframework.context.annotation: warn
    # 减少Bean后处理器检查器的日志
    org.springframework.context.support.PostProcessorRegistrationDelegate$BeanPostProcessorChecker: warn
    # MyBatis日志
    org.mybatis.spring.mapper: warn
    com.baomidou.mybatisplus: warn
# 日志格式（JSON格式便于解析）
  pattern:
    file: '{"timestamp":"%d{yyyy-MM-dd HH:mm:ss.SSS}","level":"%level","service":"${spring.application.name}","message":"%msg"}%n'
        
# Feign 错误处理配置
feign:
  client:
    config:
      default:
        errorDecoder: com.bgpay.bgai.feign.UserServiceFeignConfig.userServiceErrorDecoder
  circuitbreaker:
    enabled: true
    group:
      enabled: true
    alphanumeric-ids:
      enabled: true
# Resilience4j 配置
resilience4j:
  circuitbreaker:
    configs:
      default:
        failureRateThreshold: 50           # 失败率阈值
        slowCallRateThreshold: 50          # 慢调用率阈值
        slowCallDurationThreshold: 5000    # 慢调用时间阈值，单位ms
        slidingWindowSize: 10              # 滑动窗口大小
        slidingWindowType: COUNT_BASED     # 滑动窗口类型(基于次数)
        minimumNumberOfCalls: 5            # 最小调用次数，断路器计算失败率所需的最小调用数
        waitDurationInOpenState: 10000     # 断路器从打开到半开的等待时间
        permittedNumberOfCallsInHalfOpenState: 3  # 半开状态允许的调用次数
        automaticTransitionFromOpenToHalfOpenEnabled: true  # 是否自动从打开到半开转换
        recordExceptions:                  # 记录为失败的异常类型
          - java.io.IOException
          - java.util.concurrent.TimeoutException
          - java.lang.RuntimeException
    instances:
      feignClientDefault:
        registerHealthIndicator: true
        slidingWindowType: COUNT_BASED
        slidingWindowSize: 10
        minimumNumberOfCalls: 5
        failureRateThreshold: 50
        waitDurationInOpenState: 10s
        permittedNumberOfCallsInHalfOpenState: 3
        automaticTransitionFromOpenToHalfOpenEnabled: true
        maxAttempts: 3
        timeoutDuration: 5s
      getUserBreaker:
        registerHealthIndicator: true
        slidingWindowType: COUNT_BASED
        slidingWindowSize: 10
        minimumNumberOfCalls: 5
        failureRateThreshold: 50
        waitDurationInOpenState: 10s
        permittedNumberOfCallsInHalfOpenState: 3
        automaticTransitionFromOpenToHalfOpenEnabled: true
      deepseekApiBreaker:
        baseConfig: default
        slidingWindowSize: 10
        failureRateThreshold: 50
        waitDurationInOpenState: 10s
      emptyQuestionBreaker:
        baseConfig: default
        slidingWindowSize: 5
        waitDurationInOpenState: 5s
      fileProcessingBreaker:
        baseConfig: default
        slidingWindowSize: 5
        waitDurationInOpenState: 5s
  timelimiter:
    configs:
      default:
        timeoutDuration: 60s
    instances:
      deepseekApiBreaker:
        timeoutDuration: 60s
      emptyQuestionBreaker:
        timeoutDuration: 10s
      fileProcessingBreaker:
        timeoutDuration: 30s
  # 重试配置  
  retry:
    configs:
      default:
        maxRetryAttempts: 3
        waitDuration: 1000
        enableExponentialBackoff: true
        exponentialBackoffMultiplier: 2
        retryExceptions:
          - java.io.IOException
          - java.util.concurrent.TimeoutException
        ignoreExceptions:
          - java.lang.IllegalArgumentException
    instances:
      userServiceRetry:
        baseConfig: default
      feignClientDefault:
        retryExceptions:
          - java.io.IOException
          - java.util.concurrent.TimeoutException
      deepseekApiRetry:
        baseConfig: default
        maxAttempts: 2
        waitDuration: 2s
deepseek:
  api:
    timeout: 120000  # 120秒超时
    max-retries: 3   
