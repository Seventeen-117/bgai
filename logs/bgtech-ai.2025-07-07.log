bgpay:
  bgai:
    redis:
      single:
        address: redis://8.133.246.113:6379
        password: 5z25u2sk
        connectionPoolSize: 16
        connectionMinimumIdleSize: 4
        idleConnectionTimeout: 10000
        connectTimeout: 10000
        timeout: 3000
# 应用配置
bgai:
  mock:
    discovery: true  # 设置为true启用模拟服务注册，解决多个DiscoveryClient冲突
  api-key:
    enabled: true
    header-name: X-API-Key
    test-key: test-api-key-123  # 添加测试API Key配置
# OCR Configuration
tesseract:
  data:
    path: /usr/share/tesseract-ocr

# MyBatis-Plus Configuration
mybatis-plus:
  mapper-locations: classpath*:/mapper/**/*.xml
  type-aliases-package: com.bgpay.bgai.entity
  configuration:
    map-underscore-to-camel-case: true
    cache-enabled: false
    log-impl: org.apache.ibatis.logging.slf4j.Slf4jImpl
  global-config:
    db-config:
      id-type: auto
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

#mq
rocketmq:
  name-server: 8.133.246.113:9876
  producer:
    group: billing-producer-group
    send-message-timeout: 3000
    retry-times-when-send-failed: 2
  consumer:
    group: billing-consumer-group
    consume-timeout: 120s
  topic:
    chat-log: chat_log_topic

# 新增配置
conversation:
  max-rounds: 5 # 最大保留5轮完整对话（10条消息）
flink:
  job-manager:
    host: 8.133.246.113
    port: 8081 
file:
  output:
    path: /var/data/ai_responses
# 日志文件路径
logging:
  file:
    path: /var/data/ai_responses
    name: ${logging.file.path}/application.log
  config: classpath:nacos-logback.xml
  level:
    com.alibaba.nacos: INFO
    com.alibaba.nacos.client: INFO 
    com.bgpay.bgai.mapper: debug 
    io.seata: info
    com.bgpay.bgai: debug
    com.bgpay.bgai.feign: DEBUG
    org.springframework.cloud.context.scope: warn
    org.springframework.context.support: warn
    org.springframework.beans.factory.support: warn
    org.springframework.cloud.commons.util: warn
    org.springframework.context.annotation: warn
    # 减少Bean后处理器检查器的日志
    org.springframework.context.support.PostProcessorRegistrationDelegate$BeanPostProcessorChecker: warn
    # MyBatis日志
    org.mybatis.spring.mapper: warn
    com.baomidou.mybatisplus: warn
# 日志格式（JSON格式便于解析）
  pattern:
    file: '{"timestamp":"%d{yyyy-MM-dd HH:mm:ss.SSS}","level":"%level","service":"${spring.application.name}","message":"%msg"}%n'
        
# Feign 错误处理配置
feign:
  client:
    config:
      default:
        errorDecoder: com.bgpay.bgai.feign.UserServiceFeignConfig.userServiceErrorDecoder
  circuitbreaker:
    enabled: true
    group:
      enabled: true
    alphanumeric-ids:
      enabled: true
# Resilience4j 配置
resilience4j:
  circuitbreaker:
    configs:
      default:
        failureRateThreshold: 50           # 失败率阈值
        slowCallRateThreshold: 50          # 慢调用率阈值
        slowCallDurationThreshold: 5000    # 慢调用时间阈值，单位ms
        slidingWindowSize: 10              # 滑动窗口大小
        slidingWindowType: COUNT_BASED     # 滑动窗口类型(基于次数)
        minimumNumberOfCalls: 5            # 最小调用次数，断路器计算失败率所需的最小调用数
        waitDurationInOpenState: 10000     # 断路器从打开到半开的等待时间
        permittedNumberOfCallsInHalfOpenState: 3  # 半开状态允许的调用次数
        automaticTransitionFromOpenToHalfOpenEnabled: true  # 是否自动从打开到半开转换
        recordExceptions:                  # 记录为失败的异常类型
          - java.io.IOException
          - java.util.concurrent.TimeoutException
          - java.lang.RuntimeException
    instances:
      feignClientDefault:
        registerHealthIndicator: true
        slidingWindowType: COUNT_BASED
        slidingWindowSize: 10
        minimumNumberOfCalls: 5
        failureRateThreshold: 50
        waitDurationInOpenState: 10s
        permittedNumberOfCallsInHalfOpenState: 3
        automaticTransitionFromOpenToHalfOpenEnabled: true
        maxAttempts: 3
        timeoutDuration: 5s
      getUserBreaker:
        registerHealthIndicator: true
        slidingWindowType: COUNT_BASED
        slidingWindowSize: 10
        minimumNumberOfCalls: 5
        failureRateThreshold: 50
        waitDurationInOpenState: 10s
        permittedNumberOfCallsInHalfOpenState: 3
        automaticTransitionFromOpenToHalfOpenEnabled: true
      deepseekApiBreaker:
        baseConfig: default
        slidingWindowSize: 10
        failureRateThreshold: 50
        waitDurationInOpenState: 10s
      emptyQuestionBreaker:
        baseConfig: default
        slidingWindowSize: 5
        waitDurationInOpenState: 5s
      fileProcessingBreaker:
        baseConfig: default
        slidingWindowSize: 5
        waitDurationInOpenState: 5s
  timelimiter:
    configs:
      default:
        timeoutDuration: 60s
    instances:
      deepseekApiBreaker:
        timeoutDuration: 60s
      emptyQuestionBreaker:
        timeoutDuration: 10s
      fileProcessingBreaker:
        timeoutDuration: 30s
  # 重试配置  
  retry:
    configs:
      default:
        maxRetryAttempts: 3
        waitDuration: 1000
        enableExponentialBackoff: true
        exponentialBackoffMultiplier: 2
        retryExceptions:
          - java.io.IOException
          - java.util.concurrent.TimeoutException
        ignoreExceptions:
          - java.lang.IllegalArgumentException
    instances:
      userServiceRetry:
        baseConfig: default
      feignClientDefault:
        retryExceptions:
          - java.io.IOException
          - java.util.concurrent.TimeoutException
      deepseekApiRetry:
        baseConfig: default
        maxAttempts: 2
        waitDuration: 2s
deepseek:
  api:
    timeout: 120000  # 120秒超时
    max-retries: 3   
# SSO 配置
sso:
  client-id: bgai-client-id
  client-secret: bgai-client-secret
  redirect-uri: http://localhost:8080/api/auth/callback
  authorize-url: http://localhost:8080/auth/authorize
  token-url: http://localhost:8080/auth/token
  user-info-url: http://localhost:8080/auth/userinfo
  logout-url: http://localhost:8080/auth/logout
api:
  security:
    header-name: X-API-Key
    api-keys:
      "804822262af64439aeab611143864948": "client-1"
      "fdac4b850ba74f8f86338d3c445a88f5": "client-2"
seata:
  enabled: true
  application-id: ${spring.application.name}
  tx-service-group: default_tx_group
  enable-auto-data-source-proxy: true
  use-jdk-proxy: true
  service:
    vgroupMapping:
      default_tx_group: default
    grouplist:
      default: 8.133.246.113:8091
  registry:
    type: nacos
    nacos:
      server-addr: ${NACOS_HOST:8.133.246.113}:${NACOS_PORT:8848}
      namespace: ${NACOS_NAMESPACE:d750d92e-152f-4055-a641-3bc9dda85a29}
      group: SEATA_GROUP
  config:
    type: nacos
    nacos:
      server-addr: ${NACOS_HOST:8.133.246.113}:${NACOS_PORT:8848}
      namespace: ${NACOS_NAMESPACE:d750d92e-152f-4055-a641-3bc9dda85a29}
      group: SEATA_GROUP
      data-id: seataServer.properties
  serializer: jackson
  compressor: none
  accesskey: ""
  secretkey: ""
  security:
    secretKey: ""
    accessKey: ""
  saga:
    enabled: true
    state-machine:
      resources: classpath*:statelang/*.json
http:
  max-conn: 200 # 根据实际负载调整
  max-conn-per-route: 50
  max:
    conn: 500
    conn.per.route: 50

# Actuator配置
management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics,prometheus
  endpoint:
    health:
      show-details: always
  metrics:
    tags:
      application: ${spring.application.name}
# SSL 配置
ssl:
  cert-path: ${SSL_CERT_PATH:/path/to/cert.pem}
  private-key-path: ${SSL_PRIVATE_KEY_PATH:/path/to/private-key.pem}
  trust-cert-path: ${SSL_TRUST_CERT_PATH:/path/to/trust-cert.pem}

# MQTT 配置
mqtt:
  broker:
    url: tcp://8.133.246.113:1883
  client:
    id: bgai_${random.uuid}
  default:
    topic: bgai/default
# SpringDoc OpenAPI完整配置
springdoc:
  api-docs:
    enabled: true
    path: /v3/api-docs
    groups:
      enabled: true
  swagger-ui:
    path: /swagger-ui.html
    tags-sorter: alpha
    operations-sorter: alpha
    disable-swagger-default-url: true
    doc-expansion: none
    display-request-duration: true
    urls-primary-name: chat
    csrf:
      enabled: false
  packages-to-scan: com.bgpay.bgai.controller
  paths-to-match: /api/**
  group-configs:
    - group: auth
      paths-to-match: /api/auth/**
      display-name: 认证授权
    - group: chat
      paths-to-match: /api/chat/**
      display-name: 聊天服务
    - group: user
      paths-to-match: /api/user/**
      display-name: 用户服务
    - group: apikey
      paths-to-match: /api/keys/**
      display-name: API密钥管理
    - group: system
      paths-to-match: /api/*/
      display-name: 系统服务
