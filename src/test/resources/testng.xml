<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="BGAI Test Suite" verbose="2">
    <!-- MVC测试组 -->
    <test name="MVC Tests">
        <groups>
            <run>
                <include name="mvc-tests"/>
                <exclude name="webflux-tests"/>
            </run>
        </groups>
        <classes>
            <class name="com.bgpay.bgai.controller.AuthControllerTest" />
            <class name="com.bgpay.bgai.controller.SimpleAuthControllerTest" />
        </classes>
    </test>
    
    <!-- WebFlux测试组 -->
    <test name="WebFlux Tests">
        <groups>
            <run>
                <include name="webflux-tests"/>
                <exclude name="mvc-tests"/>
            </run>
        </groups>
        <classes>
            <class name="com.bgpay.bgai.controller.ChatGatWayInternalIdempotenceTest" />
        </classes>
    </test>
</suite> 