	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// 生成时间戳",
					"pm.globals.set('timestamp', Date.now().toString());",
					"",
					"// 生成随机数",
					"pm.globals.set('nonce', Math.random().toString(36).substring(2, 15) + Math.random().toString(36).substring(2, 15));",
					"",
					"// 生成签名（这里需要根据实际的签名算法来实现）",
					"// 注意：这只是示例，实际使用时需要根据服务端的签名算法来生成",
					"const appId = 'test-app-001';",
					"const secret = 'secret_test_app_001';",
					"const timestamp = pm.globals.get('timestamp');",
					"const nonce = pm.globals.get('nonce');",
					"",
					"// 构造待签名字符串（按字典序排列）",
					"const stringToSign = `appId=${appId}&nonce=${nonce}&param1=value1&param2=value2&timestamp=${timestamp}`;",
					"",
					"// 这里应该使用HMAC-SHA256算法计算签名",
					"// 由于Postman的限制，这里使用一个简单的哈希作为示例",
					"const signature = CryptoJS.HmacSHA256(stringToSign, secret).toString();",
					"pm.globals.set('signature', signature);"
				]
			}
		}
	],
